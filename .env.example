# Copy to .env on the server. Never commit the real file.
COMPANION_API_TOKEN=replace-with-a-long-random-token
COMPANION_BIND_ADDRESS=127.0.0.1
COMPANION_PORT=8088
DOCKER_NETWORK=mediaserver_default
NAVIDROME_LIBRARY_HOST_PATH=/mnt/media/HDD/mediaserver/music
NAVIDROME_LIBRARY_PATH=/music
NAVIDROME_API_URL=http://navidrome:4533
# false runs Companion for Jam without slskd or music/download folder mounts.
DOWNLOADS_ENABLED=true
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
SLSKD_API_URL=http://slskd:5030
SLSKD_DOWNLOAD_HOST_PATH=/mnt/media/HDD/mediaserver/downloads
SLSKD_DOWNLOAD_PATH=/downloads
# First-to-last audio format preference for automatic slskd selection.
ACQUISITION_FORMAT_ORDER=flac,mp3,other
# Switch peers after this many seconds without bytes in a remote queue/transfer.
ACQUISITION_STALL_TIMEOUT_SECONDS=180
# First successful configured source wins; Qobuz is skipped if credentials are blank.
ACQUISITION_PROVIDER_ORDER=slskd,qobuz
# Prefer an API key. Username/password are the alternative.
SLSKD_API_KEY=
SLSKD_USERNAME=
SLSKD_PASSWORD=
# Optional Qobuz subscription credentials; leave blank to disable Qobuz.
QOBUZ_USERNAME=
QOBUZ_PASSWORD=
# Optional AcoustID application key for fingerprint-assisted download verification.
ACOUSTID_API_KEY=
# Optional public artist/album enrichment. Blank disables all Last.fm requests; no user login needed.
LASTFM_API_KEY=

# For SMB/NAS storage, set these to the media account from `id -u` / `id -g`.
# Defaults match the non-root user in the image. Existing state needs matching ownership.
COMPANION_UID=10001
COMPANION_GID=10001

# Optional catalogue-state directory; normally supplied by the Compose files.
COMPANION_STATE_PATH=
